# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=envirosense_system

# Server Configuration
PORT=5000

# Sensor simulation cron (default: every hour at minute 0)
# SENSOR_CRON=0 * * * *

# JWT Secret (Change this in production!)
JWT_SECRET=nagaon_river_secret_key_2024_change_in_production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ---- Critical alert notifications (email + SMS) ----
# Without these, alerts run in DEMO mode (every email/SMS is logged in full
# on the backend console, so the flow stays visible without a paid gateway).
# SMTP (e.g. Gmail App Password) — emails to registered subscribers + ALERT_EMAIL_TO
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=EnviroSense <your.email@gmail.com>
# ALERT_EMAIL_TO=admin@nagaon.com
# SMS via Twilio (optional) — messages to registered mobile numbers
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# SMS_FROM=+91XXXXXXXXXX